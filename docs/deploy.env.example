# AeroCast-NCR production environment template (Docker Compose).
# Copy to a private location (e.g. `deploy.env`) on each host and fill in real
# values. Never commit this file or any real secret.

# --- Database (must match docker-compose `db` service) ---
DATABASE_URL=postgresql://aerocast:CHANGE_ME_PASSWORD@db:5432/aerocast_ncr

# --- Backend ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API behind the proxy.
CORS_ORIGINS=https://your-domain.example

# Optional: register a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/
NASA_FIRMS_MAP_KEY=

# --- Live data refresh scheduler ---
LIVE_REFRESH_ENABLED=true
LIVE_REFRESH_INTERVAL_HOURS=3
