# Database (SQLite for dev, Postgres for production)
# DATABASE_URL=sqlite:///./aerocast_ncr.db
DATABASE_URL=postgresql://aerocast:aerocast_secret_2024@localhost:5432/aerocast_ncr

# data.gov.in CPCB "Real time Air Quality Index from various locations"
# Get a free API key: register at https://data.gov.in -> Dashboard -> MyAccount
# (Your API key is private; never commit the real value).
DATA_GOV_API_KEY=
DATA_GOV_API_URL=https://api.data.gov.in
DATA_GOV_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
# Comma-separated NCR cities the official ingestion pipeline filters on.
DATA_GOV_NCR_CITIES=Delhi,Gurugram,Noida,Ghaziabad,Faridabad
DATA_GOV_TIMEOUT=30

# NASA FIRMS (register free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/)
NASA_FIRMS_MAP_KEY=your_firms_map_key_here

# Copernicus ERA5 - create ~/.cdsapirc with your CDS API credentials:
#   url: https://cds.climate.copernicus.eu/api
#   key: <UID>:<API_KEY>

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Portal authentication (SIH26082) ---
# HS256 JWT signing secret. MUST be overridden (long random value) outside dev.
SECRET_KEY=aerocast-dev-secret-change-me-in-production
# Session lifetime in minutes (default 480 = one operational shift).
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Demo account seeded at startup; only reachable ENV-driven, never hardcoded in UI.
DEMO_USER_EMAIL=analyst@aerocast.in
DEMO_USER_NAME=Demo Analyst
DEMO_USER_ROLE=Analyst
DEMO_USER_PASSWORD=AeroCast@2026

# Live auto-refresh (weather / fire / pollution)
LIVE_REFRESH_ENABLED=false
LIVE_REFRESH_INTERVAL_HOURS=3

# Optional demo self-hydration: when true (and no pollution/weather reading in
# the last 24h) the app loads the bundled coupled dataset + model metrics +
# alerts and re-stamps recent observations, so a fresh or stale database shows
# a live-looking dashboard without manual steps. Defaults to false.
DEMO_HYDRATE_EMPTY_DB=false

# Optional cold-start cache pre-warm. On scale-to-zero hosts (Render free tier) a
# cold wake takes ~76s and the dashboard then fans out ~14 requests, several of
# them ~12s aggregations; enabling this fills the TTL cache with those payloads in
# the background right after startup so the first load is served warm. Never
# blocks readiness. Defaults to false.
CONTROL_ROOM_PREWARM=false

# Optional: enable coverage when running the test suite
# CI=true
# COVERAGE_PROCESS_START=backend/.coveragerc