# binary model & data files must never be text-normalized
models/*.joblib binary
models/*.pkl binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# normalize line endings consistently across the text surface
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.ps1 text eol=lf
*.editorconfig text eol=lf
*.md text eol=lf
*.json text eol=lf