# binary model & data files must never be text-normalized
models/*.joblib binary
models/*.pkl binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# normalize line endings consistently across the text surface
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text
*.json text