# local caches & build artifacts (context-excluded from all Docker builds)
__pycache__/
*.pyc
node_modules/
dist/
.vite/
.pytest_cache/
.ml-cache/
*.egg-info/
.DS_Store
*.log

# secrets never enter an image build context
.env

# large runtime data — mounted as volumes in docker-compose, not baked in
data/
models/
*.db
*.sqlite
*.sqlite3